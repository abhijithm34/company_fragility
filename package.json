{
  "name": "company-fragility",
  "version": "1.0.0",
  "private": true,
  "description": "Corporate Fragility Early Warning System - Full-stack ML dashboard",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "cd frontend && npm run build",
    "start:backend": "cd backend && npm start",
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "test:backend": "cd backend && npm test",
    "test:python": "pytest tests/ -v --cov=src",
    "train": "python train_fragility_model.py",
    "score": "python score_csv.py",
    "build:data": "python scripts/build_dataset_from_raw.py",
    "lint:frontend": "cd frontend && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
